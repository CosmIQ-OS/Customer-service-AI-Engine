PORT=3001
# Production PostgreSQL URL (Neon pooled -pooler endpoint). Required on Render Free Tier for persistent storage.
# Example: postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Direct (unpooled) Neon URL used for DDL schema migrations & bulk data imports
DATABASE_URL_UNPOOLED=
# Local embedded PostgreSQL (PGlite) directory used when DATABASE_URL is unset
DB_PATH=./data/pglite
DASHBOARD_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=120
TENANT_ID=default

# mock works without credentials; use openai-compatible (or openai) for a live model
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional stronger model for the pricing agent; leave blank to reuse LLM_MODEL
PRICING_LLM_MODEL=
PRICING_AGENT_TEMPERATURE=0
LLM_TIMEOUT_MS=30000
AGENT_MAX_STEPS=6
AGENT_MAX_HISTORY=12
AGENT_TEMPERATURE=0.2
# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated admin chat ids that receive operational alerts (quote approvals, escalations)
TELEGRAM_ADMIN_CHAT_IDS=
# Set to false to use webhook ingress only instead of long polling
TELEGRAM_POLLING=true

# WhatsApp Business Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Admin dashboard sign-in. Create accounts with: npm run admin:create -- <username>
ADMIN_SESSION_HOURS=12
# Set true when the dashboard is served over HTTPS (for example on Render or through a Cloudflare tunnel)
COOKIE_SECURE=false
# Required header x-webhook-secret for POST /api/channels/:channel/inbound (16+ chars; blank disables ingress)
CHANNEL_WEBHOOK_SECRET=
# Cloudflare tunnel token, only needed for `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=

# Quote pricing and conversation timing
# QUOTE_MARGIN_PERCENT seeds the starting markup only; admins can change it in the dashboard within 30-35
QUOTE_MARGIN_PERCENT=30
# Admins are re-alerted and the customer gets a price-free holding update every window until a decision
QUOTE_APPROVAL_WINDOW_HOURS=6
CONVERSATION_IDLE_MINUTES=60

# Invoice Ninja v5.13.56 (start with: docker compose --profile invoicing up -d)
INVOICE_NINJA_BASE_URL=http://invoiceninja
INVOICE_NINJA_API_TOKEN=
INVOICE_NINJA_TIMEOUT_MS=20000

# Invoice Ninja application and database. Generate all secrets locally; never commit real values.
APP_URL=http://localhost:8080
APP_KEY=
APP_ENV=production
APP_DEBUG=false
REQUIRE_HTTPS=false
TRUSTED_PROXIES=*
IS_DOCKER=true
FILESYSTEM_DISK=debian_docker
PDF_GENERATOR=snappdf
IN_USER_EMAIL=
IN_PASSWORD=
DB_CONNECTION=mysql
DB_HOST=invoice-ninja-db
DB_PORT=3306
DB_DATABASE=invoiceninja
DB_USERNAME=invoiceninja
# Required for the invoicing profile: docker compose fails fast if either is blank.
# Generate unique values locally, e.g. `openssl rand -base64 24`.
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_HOST=invoice-ninja-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Set an SMTP provider before using Send Invoice. Log mail is only for local tests.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
