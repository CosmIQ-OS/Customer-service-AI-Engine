PORT=3001
DB_PATH=./data/support.db
DASHBOARD_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=120
TENANT_ID=default

# mock works without credentials; use openai-compatible (or openai) for a live model
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
AGENT_MAX_STEPS=6
AGENT_MAX_HISTORY=12
AGENT_TEMPERATURE=0.2
# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=

# Admin dashboard sign-in. Create accounts with: npm run admin:create -- <username>
ADMIN_SESSION_HOURS=12
# Set true when the dashboard is served over HTTPS (for example through a Cloudflare tunnel)
COOKIE_SECURE=false
# Required header x-webhook-secret for POST /api/channels/:channel/inbound (16+ chars; blank disables ingress)
CHANNEL_WEBHOOK_SECRET=

# Quote pricing and conversation timing
QUOTE_MARGIN_PERCENT=30
QUOTE_APPROVAL_WINDOW_HOURS=6
CONVERSATION_IDLE_MINUTES=60