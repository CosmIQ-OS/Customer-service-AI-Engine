{
  "name": "telegram-agent-support-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/db/schema.sql','dist/db/schema.sql');fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true});\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/adapters/*.test.ts src/approvals/*.test.ts src/auth/*.test.ts src/config/*.test.ts src/db/*.test.ts src/engine/*.test.ts src/intake/*.test.ts src/invoicing/*.test.ts src/llm/*.test.ts src/pricing/*.test.ts src/server/*.test.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "admin:passwd": "tsx src/cli/reset-password.ts",
    "db:migrate-sqlite": "tsx src/cli/migrate-sqlite.ts",
    "eval": "tsx eval/run-eval.ts",
    "audit": "npm audit --audit-level=high",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "setup": "npm install && npm --prefix dashboard install"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "read-excel-file": "^9.3.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "write-excel-file": "^4.1.1"
  }
}
